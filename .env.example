DEBUG=False
SECRET_KEY=

HOST_URL=django.localhost
HOST_PORT=8000

# Docker (see compose.yaml; defaults shown)
# POSTGRES_USER=django
# POSTGRES_PASSWORD=django
# POSTGRES_DB=django
# User the web container runs as; `just` fills these from `id -u`/`id -g`,
# so they are only needed when calling `docker compose` directly
# HOST_UID=1000
# HOST_GID=1000
# IN_DOCKER is set by the Dockerfile to enable the Docker-aware debug toolbar
# check; do not set it for a native run

# To use the compose database from a native `just run` (requires exposing port 5432):
# DATABASE_URL=postgres://django:django@localhost:5432/django
# Reserved characters in a password embedded in a URL (#, @, /, :, %, ...) must be
# percent-encoded (e.g. @ -> %40), or omit the password from the URL and set PGPASSWORD.
